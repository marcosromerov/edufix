# Postgres connection (Railway provee este valor en el plugin)
DATABASE_URL="postgresql://user:password@host:5432/edufix"

# Secreto para firmar JWTs - generar con: openssl rand -base64 32
JWT_SECRET="cambiame-en-produccion-usa-un-string-largo-y-random"

# Puerto del servidor (Railway lo setea automaticamente)
PORT=3000

# Ambiente: development | production
NODE_ENV=development
